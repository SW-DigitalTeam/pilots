{
  "name": "pwatemplate",
  "version": "0.1.0",
  "private": true,
  "description": "PWA template monorepo for Sport Waikato school-gym pilots. Hosts the shell contract, the framework-agnostic arcade-engine, its React binding, and starter apps.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty",
    "privacy:audit": "node scripts/privacy-audit.mjs",
    "gen:fixtures": "node scripts/generate-fixtures.mjs",
    "gen:voice": "node scripts/generate-voice-script.mjs",
    "gen:music": "node scripts/generate-music.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm privacy:audit",
    "dev:standard": "pnpm --filter @sw/app-standard dev",
    "build:standard": "pnpm --filter @sw/app-standard build"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "esbuild": "0.21.5",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
