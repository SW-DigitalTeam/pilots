{
  "name": "@sw/arcade-react",
  "version": "0.1.0",
  "description": "React binding that mounts the arcade-engine: the ArcadeArena component, the calibration/gameplay lifecycle, the canvas renderer, cheap 3-shape lip sync, and the MediaPipe pose capture. Consumes the shell's consent gate and cameraPose provider.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@sw/arcade-engine": "workspace:*",
    "@sw/shell": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "optionalDependencies": {
    "@mediapipe/tasks-vision": "^0.10.14"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^25.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
